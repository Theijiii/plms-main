<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow PHP files
    RewriteCond %{REQUEST_URI} \.php$ [NC]
    RewriteRule ^ - [L]

    # Serve existing files/folders
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # SPA fallback
    RewriteRule ^ index.html [L]
</IfModule>
